# =========================
# 1. ファイル数の多いディレクトリ (パフォーマンス最適化)
# =========================
# Gitが早期に走査を打ち切れるよう、内部ファイルが膨大なディレクトリを最上部に配置
node_modules/
__pycache__/
*.py[cod]
.idea/
.history/
$RECYCLE.BIN/

# =========================
# 2. OSが作成するファイル
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux / ChromeOS
*~
.fuse_hidden*
.directory
.Trash-*

# =========================
# 3. エディター・IDEのファイル
# =========================
# VSCodium / VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.iml

# =========================
# 4. ログ（Node.js・aglint）
# =========================
npm-debug.log
yarn-error.log
.pnpm-debug.log
