{
  "schema_version": 2,
  "policy": "reviewed-only",
  "targets": {
    "adguard-browser-extension-mv3": {
      "converter": "scripts/convert.py",
      "regex_engine": "RE2",
      "unsupported_rule_families": ["html-filtering", "redirect-rule"],
      "converter_settings": {
        "adguard_extended_css": [
          ":has(",
          ":has-text(",
          ":contains(",
          ":matches-css(",
          ":matches-css-after(",
          ":matches-css-before(",
          ":matches-attr(",
          ":matches-property(",
          ":xpath(",
          ":nth-ancestor(",
          ":upward(",
          ":remove()"
        ],
        "unsupported_ubo_extended_css": [
          ":matches-path(",
          ":min-text-length(",
          ":watch-attr(",
          ":matches-media(",
          ":others()"
        ],
        "compatible_scriptlets": [
          "acis",
          "spoof-css",
          "m3u-prune",
          "json-prune"
        ],
        "incompatible_scriptlets": [
          "trusted-replace-argument",
          "trusted-set-cookie",
          "alert-buster",
          "trusted-click-element",
          "webassembly-interference",
          "json-prune-set"
        ],
        "modifier_replacements": {
          "queryprune": "removeparam",
          "3p": "third-party",
          "1p": "~third-party"
        }
      },
      "scriptlet_policy": {
        "source_syntax": "uBlock Origin",
        "target_syntax": "AdGuard",
        "rule": "ブロッカー間で名前と引数の意味が互換であると確認できたスクリプトレットだけを保持します。互換性がないと確認されたものや未検証のものは、推測で変換せずコメントアウトします。",
        "trusted_scriptlets": "同じ、または関連する名前があるという理由だけで、AdGuardのtrustedスクリプトレットをuBlock Originのtrustedスクリプトレットと互換であるとは見なしません。"
      }
    },
    "adguard-for-android": {
      "converter": "scripts/convert.py",
      "compatibility": "best-effort",
      "note": "CoreLibs固有の動作はMV3とは別に検証する必要があります。"
    }
  }
}
